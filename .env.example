# Use an eligible Fastmail account. Grant Email and Email submission scopes.
# Hosted deployment: set this through Sites environment secrets and redeploy.
# Local development: set this in the process environment before npm start.
FASTMAIL_API_TOKEN=
# Optional defense in depth for hosted access, using the Sites user ID.
OWNER_ID=
PORT=4173
APP_SECRET=
DATA_DIR=.data
ALLOW_REGISTRATION=true
MAX_MAILBOXES_PER_ORG=25
# Production mail hosting, served by Stalwart v1 on a mail-capable host.
MAIL_SERVER_URL=
MAIL_HOSTNAME=
MAIL_ADMIN_TOKEN=
# Optional explicit application origin, otherwise Render's URL is used.
APP_ORIGIN=
