COMPOSE_PROJECT_NAME=courier
APP_HOSTNAME=courier.example.com
MAIL_HOSTNAME=mail.example.com
ACME_EMAIL=admin@example.com
STALWART_TAG=v1
CADDY_TAG=2-alpine
# Keep closed until the Stalwart wizard, authentication, and TLS are configured.
MAIL_ROUTE=mail_offline
# Enable briefly to create the owner, then disable and recreate app.
ALLOW_REGISTRATION=false
